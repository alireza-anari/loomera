+</head>
+<body>
+  <header class="header">
+    <div class="title-wrap">
+      <div class="eyebrow">گزارش مدیریتی Loomera</div>
+      <h1>{{ salon.salon_name }}</h1>
+      <div class="subline">خلاصه عملکرد و جزئیات گزارش در بازه انتخاب‌شده</div>
+    </div>
+    {% if pdf_logo_uri %}<div class="brand"><img src="{{ pdf_logo_uri }}" alt="Loomera"></div>{% endif %}
+  </header>
+
+  <section class="meta-strip">
+    <div class="meta-box"><div class="meta-label">بازه گزارش</div><div class="meta-value">{{ reports_dashboard.active_range_label }}</div></div>
+    <div class="meta-box"><div class="meta-label">آخرین به‌روزرسانی</div><div class="meta-value">{{ reports_dashboard.filter_summary.last_updated }}</div></div>
+    <div class="meta-box"><div class="meta-label">تعداد رکورد</div><div class="meta-value">{{ reports_dashboard.workspace.result_count_label }}</div></div>
+  </section>
+
+  {% if reports_dashboard.active_filter_chips %}
+    <div>
+      {% for chip in reports_dashboard.active_filter_chips %}<span class="filter-chip">{{ chip.label }}: {{ chip.value }}</span>{% endfor %}
+    </div>
+  {% endif %}
+
+  <h2 class="section-title">خلاصه عملکرد</h2>
+  <section class="kpi-grid">
+    {% for card in reports_dashboard.stats %}
+      <article class="kpi">
+        <div class="kpi-label">{{ card.title }}</div>
+        <div class="kpi-value">{{ card.value }}</div>
+        {% if card.meta %}<div class="kpi-meta">{{ card.meta }}</div>{% endif %}
+      </article>
+    {% endfor %}
+  </section>
+
+  <h2 class="section-title">نگاه سریع</h2>
+  <section class="two-col">
+    <div class="panel">
+      <h3>خدمات پرفروش</h3>
+      {% if reports_dashboard.top_services.is_empty %}
+        <div class="empty">داده‌ای برای خدمات وجود ندارد.</div>
+      {% else %}
+        {% for item in reports_dashboard.top_services.items %}
+          <div class="rank-item">
+            <div class="rank-head"><span class="rank-title">{{ item.title }}</span><span class="rank-value">{{ item.value }}</span></div>
+            <div class="bar"><span style="width: {{ item.chart_end|default:0 }}%;"></span></div>
+            <div class="rank-meta">{{ item.meta }} - {{ item.chart_share_label }}</div>
+          </div>
+        {% endfor %}
+      {% endif %}
+    </div>
+
+    <div class="panel">
+      <h3>عملکرد تیم</h3>
+      {% if reports_dashboard.top_team.is_empty %}
+        <div class="empty">داده‌ای برای تیم وجود ندارد.</div>
+      {% else %}
+        {% for item in reports_dashboard.top_team.items %}
+          <div class="rank-item">
+            <div class="rank-head"><span class="rank-title">{{ item.title }}</span><span class="rank-value">{{ item.value }}</span></div>
+            <div class="bar"><span style="width: {{ item.chart_end|default:0 }}%;"></span></div>
+            <div class="rank-meta">{{ item.meta }} - {{ item.chart_share_label }}</div>
+          </div>
+        {% endfor %}
+      {% endif %}
+    </div>
+  </section>
+
+  <h2 class="section-title">وضعیت رزروها</h2>
+  <section class="panel">
+    {% if reports_dashboard.status_breakdown.is_empty %}
+      <div class="empty">برای این بازه رزروی وجود ندارد.</div>
+    {% else %}
+      <div class="status-list">
+        {% for item in reports_dashboard.status_breakdown.items %}
+          {% if item.count %}
+            <div class="status-row">
+              <span class="status-name"><span class="dot" style="background: {{ item.color }};"></span>{{ item.label }}</span>
+              <span class="status-number">{{ item.count_label }} - {{ item.share_label }}</span>
+            </div>
+          {% endif %}
+        {% endfor %}
+      </div>
+    {% endif %}
+  </section>
+
+  <h2 class="section-title">جزئیات گزارش</h2>
+  {% if reports_dashboard.table.is_empty %}
+    <div class="empty">داده‌ای برای نمایش وجود ندارد.</div>
+  {% elif reports_dashboard.table.kind == 'sales' %}
+    <table>
+      <thead><tr><th>مشتری</th><th>خدمت و متخصص</th><th>تاریخ</th><th>وضعیت</th><th>مبلغ</th></tr></thead>
+      <tbody>
+        {% for row in reports_dashboard.table.rows %}
+          <tr><td>{{ row.title }}</td><td>{{ row.subtitle }}</td><td>{{ row.date_label }}</td><td>{{ row.status.label }}</td><td>{{ row.value_label }}</td></tr>
+        {% endfor %}
+      </tbody>
+    </table>
+  {% else %}
+    <table>
+      <thead><tr><th>عنوان</th><th>توضیح</th><th>رزرو</th><th>درآمد</th><th>مشتری</th><th>تکمیل</th></tr></thead>
+      <tbody>
+        {% for row in reports_dashboard.table.rows %}
+          <tr><td>{{ row.title }}</td><td class="muted">{{ row.subtitle }}</td><td>{{ row.appointments_label }}</td><td>{{ row.revenue_label }}</td><td>{{ row.customers_label }}</td><td>{{ row.completion_label }}</td></tr>
+        {% endfor %}
+      </tbody>
+    </table>
+  {% endif %}
+
+  <div class="footer-note">این گزارش بر اساس داده‌های ثبت‌شده در Loomera و فیلترهای فعال در زمان دریافت فایل تولید شده است.</div>
+</body>
+</html>
