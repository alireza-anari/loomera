+      line-height: 1.75;
+    }
+    .header {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+      border: 1px solid #e8e2f2;
+      border-top: 5px solid #735cbe;
+      border-radius: 14px;
+      padding: 12px 14px;
+      margin-bottom: 12px;
+      background: linear-gradient(135deg, #fff 0%, #faf8fe 100%);
+    }
+    .brand img { width: 106px; height: auto; display: block; }
+    .title-wrap { flex: 1; text-align: right; }
+    .eyebrow { color: #735cbe; font-weight: 800; font-size: 8pt; margin-bottom: 2px; }
+    h1 { margin: 0; font-size: 16pt; line-height: 1.45; font-weight: 900; }
+    .subline { margin-top: 4px; color: #7d748d; font-size: 8.5pt; }
+
+    .meta-strip {
+      display: grid;
+      grid-template-columns: repeat(3, 1fr);
+      gap: 7px;
+      margin-bottom: 12px;
+    }
+    .meta-box, .kpi, .panel {
+      border: 1px solid #e8e2f2;
+      border-radius: 11px;
+      background: #fff;
+    }
+    .meta-box { padding: 7px 9px; background: #f9f7fc; }
+    .meta-label { color: #8a8198; font-size: 7.5pt; }
+    .meta-value { margin-top: 1px; font-weight: 800; font-size: 9pt; }
+
+    .section-title {
+      display: flex;
+      align-items: center;
+      gap: 7px;
+      margin: 13px 0 7px;
+      font-size: 11pt;
+      font-weight: 900;
+    }
+    .section-title::before {
+      content: "";
+      width: 4px;
+      height: 17px;
+      border-radius: 4px;
+      background: #735cbe;
+    }
+
+    .kpi-grid {
+      display: grid;
+      grid-template-columns: repeat(3, 1fr);
+      gap: 7px;
+    }
+    .kpi { padding: 9px; break-inside: avoid; }
+    .kpi-label { color: #6d657a; font-size: 8pt; font-weight: 700; }
+    .kpi-value { margin-top: 3px; font-size: 12pt; font-weight: 900; color: #2f283d; }
+    .kpi-meta { margin-top: 2px; color: #93899f; font-size: 7pt; }
+
+    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
+    .panel { padding: 10px; break-inside: avoid; }
+    .panel h3 { margin: 0 0 7px; font-size: 10pt; font-weight: 900; }
+
+    .rank-item { margin-bottom: 7px; }
+    .rank-head { display: flex; justify-content: space-between; gap: 8px; font-size: 8pt; }
+    .rank-title { font-weight: 800; max-width: 65%; }
+    .rank-value { color: #735cbe; font-weight: 900; white-space: nowrap; }
+    .bar { height: 6px; border-radius: 6px; background: #f0ecf7; overflow: hidden; margin-top: 3px; }
+    .bar > span { display: block; height: 100%; border-radius: inherit; background: #735cbe; }
+    .rank-meta { margin-top: 2px; color: #93899f; font-size: 7pt; }
+
+    .status-list { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
