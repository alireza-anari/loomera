+    .status-number { font-weight: 900; font-size: 8pt; }
+
+    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 7.4pt; }
+    thead { display: table-header-group; }
+    tr { break-inside: avoid; }
+    th {
+      padding: 6px 5px;
+      background: #735cbe;
+      color: #fff;
+      border: 1px solid #735cbe;
+      font-weight: 800;
+      text-align: right;
+    }
+    td { padding: 5px; border: 1px solid #e8e2f2; vertical-align: top; word-wrap: break-word; }
