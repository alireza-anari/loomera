+
+    @page {
+      size: A4;
+      margin: 14mm 13mm 16mm;
+      @bottom-left {
+        content: "loomera.ir";
+        color: #8a8198;
+        font-size: 8pt;
+      }
+      @bottom-right {
+        content: "صفحه " counter(page) " از " counter(pages);
+        color: #8a8198;
+        font-size: 8pt;
+      }
+    }
+
+    * { box-sizing: border-box; }
