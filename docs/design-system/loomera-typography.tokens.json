    "responsive": {
      "mobile": {
        "display.xl": "40/48",
        "display.l": "32/40",
        "heading.h1": "32/40",
        "heading.h2": "28/36",
        "heading.h3": "24/32",
        "heading.h4": "20/28",
        "heading.h5": "18/26",
        "body.lg": "17/30",
        "body.md": "16/28",
        "body.sm": "14/24"
      }
    },
    "scriptRules": {
      "persianLetterSpacing": 0,
      "persianBodyLineHeightMin": 1.7,
      "persianHeadingWeightRecommended": 600,
      "persianHeadingWeightMaxDefault": 700,
      "useTabularNumeralsForMetricsAndTables": true,
      "isolateLTRInsideRTL": true
