{
  "brand": "Loomera",
  "system": "loader-splash",
  "recommended_direction": "softly-branded-motion",
  "assets": [
    "splash-screen-main",
    "splash-screen-dark",
    "app-loader-primary",
    "section-loader",
    "inline-loader",
    "button-loader",
    "checkout-pending-loader",
    "dashboard-card-skeleton",
    "dashboard-chart-skeleton",
    "table-skeleton",
    "gallery-skeleton",
