  "variants": [
    "light",
    "dark",
    "reduced-motion",
    "compact",
    "mobile-safe"
  ],
  "component_names": {
    "app-splash-screen": "cold app launch splash",
    "global-loader": "generic full-page loader",
    "section-loader": "section scoped loader",
